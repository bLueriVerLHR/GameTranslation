__pycache__/
*.pyc
*.pyo
*.7z
*.csv
.DS_Store

# python build / test / lint caches (never commit)
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# project-local python virtualenv (machine-specific)
.venv/

# local private data: dictionaries (incl. adult word tables), passwords,
# machine config, private policy notes.  See docs/reference/local-layout.md.
.private/

# local reusable font assets (binaries; manifest.json is tracked)
.asset/

# legacy local data layout, replaced by the two dirs above; kept ignored so a
# half-migrated checkout never commits the old copy.
docs/table/

# persistent work copies (per-game temp dirs, machine-local)
tmp/
work/

# workspace-local scratch (repo stays clean; $env:TEMP for anything large)
.tmp/
PLAN.md
# Local handover/status notes, same reason as PLAN.md above: they quote the
# operator's machine state while working and are never part of the repo.
SESSION-STATUS.md

# local-only tool/runtime downloads (engine sources used as a test runtime)
.tools/

# agent harness runtime state (bg task logs / session scratch)
.pi/
