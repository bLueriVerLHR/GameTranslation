#!/usr/bin/env bash
# Fake powershell.exe for wsl_capture tests: parses -OutDir/-Out, creates
# the output file, prints the Windows-form path. FAKE_PS_FAIL simulates a
# failing capture (e.g. target window not found).
set -u
outdir=""
out=""
while [ $# -gt 0 ]; do
  case "$1" in
    -OutDir) outdir="$2"; shift 2 ;;
    -Out) out="$2"; shift 2 ;;
    -File) shift 2 ;;
    *) shift ;;
  esac
done
if [ -n "${FAKE_PS_FAIL:-}" ]; then
  echo "fake powershell failure: ${FAKE_PS_FAIL}" >&2
  exit "${FAKE_PS_EXIT:-1}"
fi
[ -z "$outdir" ] && outdir="."
[ -z "$out" ] && out="fake.png"
mkdir -p "$outdir"
printf '\x89PNG\r\n\x1a\n' > "$outdir/$out"
printf '%s/%s\n' "$outdir" "$out"
exit 0
